# ==============================================================================
# Velora Smart Hotel Platform - Environment Variables Template
# Copy this file to .env and replace with your local or production credentials.
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/hotel_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Google Gemini AI Studio API Key (for Concierge, Pricing, Sentiment & Analytics)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Port (Default 8080)
PORT=8080
